# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
# IMPORTANT: Never commit real tokens to Git!
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# SMS Configuration
# Provider: 'smsethiopia' (https://smsethiopia.com) or 'africastalking'
SMS_PROVIDER=smsethiopia
SMS_API_KEY=your_sms_ethiopia_api_key_here
SMS_ENABLED=true
# Optional settings for Africa's Talking (if used):
# SMS_USERNAME=sandbox
# SMS_SENDER_ID=

# Email / Gmail Notification Configuration
# Set EMAIL_ENABLED=true and configure your Gmail account with App Password (16 characters)
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
GMAIL_USER=your_mesob_gmail_address@gmail.com
GMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM="Hawassa MESOB Public Services" <your_mesob_gmail_address@gmail.com>
# Optional generic SMTP settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
