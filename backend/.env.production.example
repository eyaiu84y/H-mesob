# ============================================================================
# Hawassa MESOB Backend - Production Environment Variables
# ============================================================================
# Configure these in: Vercel / Render / Railway Environment Variables

# Node Environment
NODE_ENV=production
PORT=5000

# Supabase Production Database Credentials
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# JWT Token Secrets
# Generate a strong 64+ char random string
JWT_SECRET=your_super_strong_random_jwt_secret_key_for_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend URL for CORS Security
# Must match your Vercel deployment URL (without trailing slash)
FRONTEND_URL=https://your-frontend-project.vercel.app

# Optional: Telegram Bot Notifications (leave blank if not using)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: SMS Integration (Africa's Talking)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
