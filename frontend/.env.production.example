# ============================================================================
# Hawassa MESOB Frontend - Vercel Production Environment Variables
# ============================================================================
# Configure these in: Vercel Dashboard → Your Project → Settings → Environment Variables

# Backend API Base URL
# If your backend is deployed on Render/Railway/Fly.io:
# e.g., https://hawassa-mesob-api.onrender.com/api
# If deployed using fullstack Vercel serverless rewrites:
# e.g., /api
VITE_API_BASE_URL=https://your-backend-api-domain.com/api

# Application Title
VITE_APP_TITLE=Hawassa MESOB Public Service Management System
